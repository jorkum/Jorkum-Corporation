
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JORKUM | Control Económico</title>

<style>
:root {
  --fondo: #07111f;
  --panel: #101f33;
  --panel2: #142943;
  --dorado: #d5ad58;
  --azul: #55b7ff;
  --texto: #f2f5fa;
  --suave: #9eafc3;
  --borde: #263b55;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background:
    radial-gradient(ellipse at 50% 0%, #18314b 0%, transparent 55%),
    linear-gradient(135deg, #07111f, #0a1728 60%, #07111f);
  color: var(--texto);
  font-family: Arial, Helvetica, sans-serif;
  min-height: 100vh;
}

header {
  padding: 24px 5%;
  border-bottom: 1px solid var(--borde);
  background: rgba(5, 13, 24, .85);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  color: var(--dorado);
  font-size: 25px;
  font-weight: bold;
  letter-spacing: 4px;
}

.sublogo {
  color: var(--suave);
  font-size: 10px;
  letter-spacing: 3px;
  margin-top: 5px;
}

header a {
  color: var(--dorado);
  text-decoration: none;
  border: 1px solid var(--dorado);
  padding: 10px 16px;
  border-radius: 5px;
  font-size: 12px;
}

main {
  width: 92%;
  max-width: 1450px;
  margin: 35px auto;
}

.intro {
  margin-bottom: 28px;
}

.intro h1 {
  font-size: 27px;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.intro p {
  color: var(--suave);
  font-size: 14px;
}

.estado-general {
  display: inline-block;
  margin-top: 10px;
  padding: 7px 11px;
  border: 1px solid #52657b;
  border-radius: 4px;
  color: var(--suave);
  font-size: 11px;
  letter-spacing: 1px;
}

.seccion-titulo {
  color: var(--dorado);
  font-size: 13px;
  letter-spacing: 2px;
  margin: 32px 0 15px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--borde);
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
}

.marco {
  background: linear-gradient(145deg, var(--panel2), var(--panel));
  border: 1px solid var(--borde);
  border-top: 2px solid var(--dorado);
  border-radius: 8px;
  padding: 20px;
  min-height: 225px;
  box-shadow: 0 8px 24px rgba(0,0,0,.18);
  transition: transform .2s, border-color .2s;
}

.marco:hover {
  transform: translateY(-3px);
  border-color: var(--dorado);
}

.marco-cabecera {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.marco h2 {
  font-size: 15px;
  letter-spacing: 1px;
  margin: 0;
}

.simbolo {
  color: var(--azul);
  font-size: 11px;
  font-weight: bold;
  border: 1px solid #34516c;
  padding: 5px 7px;
  border-radius: 4px;
}

.valor {
  font-size: 30px;
  font-weight: bold;
  margin: 22px 0 5px;
  color: white;
}

.unidad {
  color: var(--suave);
  font-size: 12px;
}

.detalles {
  margin-top: 18px;
  padding-top: 13px;
  border-top: 1px solid var(--borde);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.detalle small {
  display: block;
  color: var(--suave);
  font-size: 10px;
  margin-bottom: 5px;
}

.detalle strong {
  font-size: 12px;
  color: #dce7f3;
}

.pendiente {
  display: inline-block;
  color: #e5c77f;
  font-size: 10px;
  margin-top: 15px;
  letter-spacing: .5px;
}

.nota {
  color: var(--suave);
  font-size: 11px;
  margin-top: 25px;
  line-height: 1.6;
}

footer {
  border-top: 1px solid var(--borde);
  padding: 22px 5%;
  color: var(--suave);
  font-size: 11px;
  text-align: center;
  letter-spacing: 1px;
}

@media (max-width: 950px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 600px) {
  .grid { grid-template-columns: 1fr; }
  .intro h1 { font-size: 21px; }
  header { padding: 20px 4%; }
}
</style>
</head>

